<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Recrutement — Urgence Lilloise</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Montserrat', 'Segoe UI', sans-serif;
    }

    body {
      background-color: #0a0a0c;
      color: #ffffff;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      background-image: linear-gradient(rgba(10, 10, 12, 0.7), rgba(10, 10, 12, 0.8)),
                        url('https://media.discordapp.net/attachments/1525200263173112018/1529295831117861006/wiwi.png?ex=6a616b3b&is=6a6019bb&hm=1bfb5328689f71af47ca2d09fddadda14f7bac737b5ae8019ea12f053690c108&=&format=webp&quality=lossless');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      background-attachment: fixed;
    }

    /* HEADER */
    header {
      padding: 25px 60px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: rgba(10, 10, 12, 0.5);
      backdrop-filter: blur(8px);
    }

    .logo {
      font-size: 1.4rem;
      font-weight: 900;
      color: #ffffff;
      text-decoration: none;
      letter-spacing: 1px;
      text-transform: uppercase;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .logo img { height: 45px; width: auto; }
    .logo span { color: #e52d48; }

    nav { display: flex; gap: 30px; align-items: center; }
    nav a { color: #a0a0a0; text-decoration: none; font-weight: 600; font-size: 0.95rem; transition: color 0.3s; }
    nav a:hover, nav a.active { color: #ffffff; }

    /* CONTENU RECRUTEMENT */
    .container {
      max-width: 1200px;
      margin: 40px auto;
      padding: 0 20px;
      flex: 1;
    }

    .section-box {
      background: rgba(18, 19, 26, 0.85);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 16px;
      padding: 35px;
    }

    .header-box {
      display: flex;
      gap: 20px;
      align-items: flex-start;
      margin-bottom: 30px;
    }

    .icon-badge {
      background: rgba(229, 45, 72, 0.15);
      border: 1px solid rgba(229, 45, 72, 0.3);
      color: #e52d48;
      width: 55px;
      height: 55px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      flex-shrink: 0;
    }

    .header-info h1 {
      font-size: 1.8rem;
      font-weight: 800;
      margin-bottom: 8px;
    }

    .header-info p {
      color: #a0a0a0;
      font-size: 0.95rem;
      line-height: 1.5;
    }

    /* GRID DES POSTES */
    .jobs-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 20px;
    }

    .job-card {
      background: #14151f;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 14px;
      padding: 25px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: transform 0.2s, border-color 0.2s;
    }

    .job-card:hover {
      transform: translateY(-5px);
      border-color: rgba(229, 45, 72, 0.5);
    }

    .job-card-icon {
      background: rgba(229, 45, 72, 0.1);
      color: #e52d48;
      width: 45px;
      height: 45px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
      margin-bottom: 15px;
    }

    .job-card h3 {
      font-size: 1.2rem;
      font-weight: 700;
      margin-bottom: 8px;
    }

    .job-card p {
      color: #8f92a1;
      font-size: 0.85rem;
      line-height: 1.4;
      margin-bottom: 20px;
    }

    .btn-apply {
      background: rgba(46, 213, 115, 0.1);
      color: #2ed573;
      border: 1px solid rgba(46, 213, 115, 0.3);
      padding: 10px 15px;
      border-radius: 8px;
      font-size: 0.85rem;
      font-weight: 700;
      cursor: pointer;
      text-align: center;
      transition: background 0.2s, transform 0.2s;
      width: 100%;
    }

    .btn-apply:hover {
      background: #2ed573;
      color: #000;
    }

    /* MODAL POPUP */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.8);
      backdrop-filter: blur(5px);
      display: none;
      justify-content: center;
      align-items: center;
      z-index: 1000;
    }

    .modal-content {
      background: #14151f;
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 16px;
      width: 90%;
      max-width: 550px;
      padding: 30px;
      position: relative;
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }

    .modal-header h2 {
      font-size: 1.4rem;
      font-weight: 800;
    }

    .close-btn {
      background: none;
      border: none;
      color: #a0a0a0;
      font-size: 1.4rem;
      cursor: pointer;
    }

    .form-group {
      margin-bottom: 18px;
    }

    .form-group label {
      display: block;
      font-size: 0.85rem;
      font-weight: 600;
      margin-bottom: 6px;
      color: #cccccc;
    }

    .form-group input, .form-group textarea {
      width: 100%;
      background: #0a0a0c;
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 8px;
      padding: 12px;
      color: #ffffff;
      font-size: 0.9rem;
      outline: none;
    }

    .form-group input:focus, .form-group textarea:focus {
      border-color: #e52d48;
    }

    .btn-submit {
      width: 100%;
      background: #e52d48;
      color: #ffffff;
      border: none;
      padding: 14px;
      border-radius: 8px;
      font-weight: 800;
      font-size: 0.95rem;
      cursor: pointer;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .btn-submit:hover {
      background: #c02138;
    }

    footer {
      background: #070708;
      border-top: 1px solid rgba(255, 255, 255, 0.05);
      padding: 20px;
      text-align: center;
      color: #666666;
      font-size: 0.85rem;
    }
    footer span { color: #e52d48; font-weight: 700; }
  </style>
</head>
<body>

  <!-- HEADER -->
  <header>
    <a href="/" class="logo">
      <img src="https://media.discordapp.net/attachments/1490687935509430293/1529274485063028807/logo.png" alt="Logo">
      Urgence Lilloise <span>Semi FivePD</span>
    </a>
    <nav>
      <a href="/">Accueil</a>
      <a href="/recrutement" class="active">Recrutement</a>
      <a href="/boutique">Boutique</a>
    </nav>
  </header>

  <!-- CONTENU -->
  <div class="container">
    <div class="section-box">
      <div class="header-box">
        <div class="icon-badge"><i class="fa-solid fa-shield-halved"></i></div>
        <div class="header-info">
          <h1>Rejoindre l'équipe du staff</h1>
          <p>Modération, assistance, animation, vidéo : plusieurs branches composent le staff d'Urgence Lilloise. Postule ci-dessous pour rejoindre l'équipe.</p>
        </div>
      </div>

      <div class="jobs-grid">
        <!-- CARTE 1 -->
        <div class="job-card">
          <div>
            <div class="job-card-icon"><i class="fa-solid fa-bullhorn"></i></div>
            <h3>Animateur</h3>
            <p>Organise des événements et anime la communauté du serveur au quotidien.</p>
          </div>
          <button class="btn-apply" onclick="openModal('Animateur')">Recrutement ouvert — postuler</button>
        </div>

        <!-- CARTE 2 -->
        <div class="job-card">
          <div>
            <div class="job-card-icon"><i class="fa-solid fa-headset"></i></div>
            <h3>Assistant</h3>
            <p>Rejoins la branche assistance : accueil des nouveaux, tickets et aide en jeu.</p>
          </div>
          <button class="btn-apply" onclick="openModal('Assistant')">Recrutement ouvert — postuler</button>
        </div>

        <!-- CARTE 3 -->
        <div class="job-card">
          <div>
            <div class="job-card-icon"><i class="fa-solid fa-video"></i></div>
            <h3>Cameraman / Vidéaste</h3>
            <p>Filme les scènes RP, réalise des bandes-annonces et valorise le serveur.</p>
          </div>
          <button class="btn-apply" onclick="openModal('Cameraman')">Recrutement ouvert — postuler</button>
        </div>

        <!-- CARTE 4 -->
        <div class="job-card">
          <div>
            <div class="job-card-icon"><i class="fa-solid fa-comments"></i></div>
            <h3>Community Manager</h3>
            <p>Gère les réseaux sociaux et la communication officielle d'Urgence Lilloise.</p>
          </div>
          <button class="btn-apply" onclick="openModal('Community Manager')">Recrutement ouvert — postuler</button>
        </div>

        <!-- CARTE 5 -->
        <div class="job-card">
          <div>
            <div class="job-card-icon"><i class="fa-solid fa-clapperboard"></i></div>
            <h3>Monteur</h3>
            <p>Monte les vidéos officielles et contenus TikTok / YouTube pour le serveur.</p>
          </div>
          <button class="btn-apply" onclick="openModal('Monteur')">Recrutement ouvert — postuler</button>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL FORMULAIRE -->
  <div class="modal-overlay" id="modalOverlay">
    <div class="modal-content">
      <div class="modal-header">
        <h2 id="modalTitle">Postuler</h2>
        <button class="close-btn" onclick="closeModal()">&times;</button>
      </div>
      <form id="applyForm">
        <input type="hidden" id="roleInput" name="role">

        <div class="form-group">
          <label>Pseudo Discord (ex: ymn_0ffcl)</label>
          <input type="text" name="discordTag" required placeholder="Ex: ymn_0ffcl">
        </div>

        <div class="form-group">
          <label>Votre Âge</label>
          <input type="number" name="age" required placeholder="Ex: 18">
        </div>

        <div class="form-group">
          <label>Vos expériences (serveurs RP, staff...)</label>
          <textarea name="experience" rows="3" required placeholder="Décrivez vos expériences précédentes..."></textarea>
        </div>

        <div class="form-group">
          <label>Pourquoi vous et pas un autre ? (Motivations)</label>
          <textarea name="motivation" rows="4" required placeholder="Vos motivations..."></textarea>
        </div>

        <button type="submit" class="btn-submit">Envoyer ma candidature</button>
      </form>
    </div>
  </div>

  <footer>
    <p>&copy; 2026 Urgence Lilloise. Tous droits réservés. — Made by <span>ymn_0ffcl</span></p>
  </footer>

  <script>
    function openModal(roleName) {
      document.getElementById('modalTitle').innerText = "Postuler au poste de " + roleName;
      document.getElementById('roleInput').value = roleName;
      document.getElementById('modalOverlay').style.display = 'flex';
    }

    function closeModal() {
      document.getElementById('modalOverlay').style.display = 'none';
    }

    document.getElementById('applyForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      
      const formData = new FormData(this);
      const data = Object.fromEntries(formData.entries());

      const response = await fetch('/postuler', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });

      const result = await response.json();
      if(result.success) {
        alert("✅ " + result.message);
        closeModal();
        this.reset();
      } else {
        alert("❌ Erreur : " + result.message);
      }
    });
  </script>
</body>
</html>
